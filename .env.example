# Copy this file to .env.local and fill in the values.
# Never commit .env.local or paste real keys anywhere public.

# --- Shelby (server) ---
SHELBY_API_KEY=
SHELBY_SIGNER_PRIVATE_KEY=

# --- Shelby / Aptos (browser-visible; use restricted client keys only) ---
NEXT_PUBLIC_APTOS_API_KEY=
NEXT_PUBLIC_SHELBY_BROWSER_API_KEY=

# --- Media details: titles, descriptions, covers ---
# Any Postgres works (Supabase, Neon, ...). The table is created automatically.
# In production this is REQUIRED to save details. Without it, public pages still
# work but show file names only.
# In development you can leave it empty: details are kept in .data/media-details.json.
DATABASE_URL=
# Optional, stricter: your database provider's CA certificate (PEM, newlines as \n).
# When set, the server certificate is fully verified. When empty, the connection
# is encrypted but the certificate is not verified.
DATABASE_CA_CERT=

# --- Optional ---
# Public site URL used in share links and previews.
NEXT_PUBLIC_SITE_URL=

# --- Live streaming (LiveKit Cloud, free plan works) ---
# Create a project at https://cloud.livekit.io, then copy these three values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Live alerts (browser notifications). Make keys with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Paid files: any random text of 16+ characters. Keep it secret and never change it after selling files.
PREMIUM_KEY_SECRET=

# Telegram alerts (create a bot with @BotFather, then run: npm run telegram:webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
